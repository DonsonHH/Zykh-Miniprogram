<view class="app-header {{compact ? 'is-compact' : ''}}">
  <view class="app-header__topline">
    <view class="app-header__brand">
      <view class="app-header__brand-mark">
        <image class="app-header__brand-image" src="/images/brand-mark.png" mode="aspectFit"></image>
      </view>
      <view class="app-header__brand-copy">
        <text class="app-header__brand-title">智药康护</text>
        <label wx:if="{{eyebrow}}" class="app-header__brand-eyebrow">{{eyebrow}}</label>
      </view>
    </view>

    <view wx:if="{{showStatus}}" class="app-header__status is-{{connectionState || (online ? 'online' : 'unavailable')}}">
      <view class="app-header__dot"></view>
      <view class="app-header__status-copy">
        <text class="app-header__status-title">{{statusText || (connectionState === 'online' || online ? '药箱在线' : (connectionState === 'stale' ? '等待药箱连接' : (connectionState === 'loading' ? '正在确认药箱状态' : (connectionState === 'unpaired' ? '请先配对药箱' : (connectionState === 'incompatible' ? '云端版本待升级' : '药箱状态暂不可用')))))}}</text>
        <label class="app-header__status-hint">{{statusHint || (connectionState === 'online' || online ? '同步正常' : (connectionState === 'stale' ? '可查看上次同步内容' : '请稍后重试'))}}</label>
      </view>
    </view>
  </view>

  <view class="app-header__page-copy">
    <view class="app-header__title">{{title}}</view>
    <view wx:if="{{subtitle}}" class="app-header__subtitle">{{subtitle}}</view>
  </view>
</view>
