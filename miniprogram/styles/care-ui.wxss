/* Shared mobile care surfaces. Keep the Station palette and hierarchy on every page. */
@keyframes care-page-enter {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes care-mask-enter {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes care-sheet-enter {
  from {
    opacity: 0;
    transform: translateY(100%);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes care-spinner {
  to { transform: rotate(360deg); }
}

.care-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f6f9fc;
  animation: care-page-enter 180ms ease-out both;
}

.ui-pressable {
  transition: transform 140ms ease-out, opacity 140ms ease-out, background-color 160ms ease-out, box-shadow 160ms ease-out;
}

.ui-loading {
  min-height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.ui-loading__spinner {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #dce8f6;
  border-top-color: #2563eb;
  border-radius: 50%;
  box-sizing: border-box;
  animation: care-spinner 720ms linear infinite;
}

.ui-loading__spinner--small {
  width: 26rpx;
  height: 26rpx;
  border-width: 3rpx;
}

.ui-loading__text {
  color: #52627a;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
}

.ui-surface {
  border: 1rpx solid #dbe7f3;
  border-radius: 24rpx;
  background: #ffffff;
}

/* Rows and static panels stay flat. Add this only to a page's primary
 * summary/hero surface so hierarchy is visible without card-on-card noise. */
.ui-surface--raised {
  box-shadow: 0 10rpx 24rpx rgba(15, 35, 70, 0.06);
}

.ui-section {
  margin-top: 30rpx;
}

.ui-section-head {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 0 4rpx 14rpx;
}

.ui-section-copy {
  min-width: 0;
}

.ui-section-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.22;
}

.ui-section-note {
  margin-top: 4rpx;
  color: #637083;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.35;
}

.ui-link {
  flex: 0 0 auto;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 4rpx;
  box-sizing: border-box;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 850;
}

.ui-kicker {
  color: #637083;
  font-size: 24rpx;
  font-weight: 850;
  letter-spacing: 0.4rpx;
  line-height: 1.2;
}

.ui-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  max-width: 100%;
  border-radius: 999rpx;
  padding: 7rpx 14rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
}

.ui-status--good {
  color: #087c68;
  background: #eaf8f3;
}

.ui-status--notice {
  color: #174fd6;
  background: #eaf2ff;
}

.ui-status--warn {
  color: #9a570b;
  background: #fff4e5;
}

.ui-status--danger {
  color: #b42318;
  background: #fff1f0;
}

.ui-status--muted {
  color: #59677b;
  background: #eef2f7;
}

.ui-list {
  overflow: hidden;
}

.ui-list-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #e8eef5;
}

.ui-list-row:last-child {
  border-bottom: 0;
}

.ui-row-mark {
  flex: 0 0 auto;
  width: 10rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #9eb2ca;
}

.ui-row-mark--good {
  background: #0f9f8f;
}

.ui-row-mark--warn {
  background: #f28c28;
}

.ui-row-mark--danger {
  background: #d92d20;
}

.ui-row-mark--notice {
  background: #2563eb;
}

.ui-row-copy {
  min-width: 0;
  flex: 1;
}

.ui-row-title {
  overflow: hidden;
  color: #172033;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ui-row-subtitle {
  overflow: hidden;
  margin-top: 5rpx;
  color: #637083;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ui-chevron {
  flex: 0 0 auto;
  color: #98a7ba;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
}

.ui-empty {
  padding: 38rpx 24rpx;
  color: #637083;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
}

.ui-sheet-mask {
  position: fixed;
  z-index: 50;
  inset: 0;
  background: rgba(15, 28, 46, 0.58);
  animation: care-mask-enter 160ms ease-out both;
}

.ui-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 51;
  max-height: 78vh;
  overflow: hidden;
  border: 1rpx solid #c9d8e8;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 48rpx rgba(15, 35, 70, 0.16);
  animation: care-sheet-enter 220ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.ui-sheet-grip {
  width: 62rpx;
  height: 8rpx;
  margin: 14rpx auto 0;
  border-radius: 999rpx;
  background: #cfd9e5;
}

.ui-sheet-head {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #e8eef5;
  box-sizing: border-box;
}

.ui-sheet-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.ui-sheet-close {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 4rpx;
  box-sizing: border-box;
  color: #2563eb;
  font-size: 27rpx;
  font-weight: 850;
}
