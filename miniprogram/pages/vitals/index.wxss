.vitals-page {
  padding-top: 20rpx;
}

.vitals-sheet__body {
  max-height: 64vh;
  box-sizing: border-box;
  padding: 18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.vitals-sheet__summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #dbe7f3;
  border-radius: 22rpx;
  background: #f6f9fc;
}

.vitals-sheet__summary-copy {
  min-width: 0;
  flex: 1;
}

.vitals-sheet__eyebrow {
  color: #52627a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.vitals-sheet__time {
  margin-top: 8rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 850;
  line-height: 1.3;
}

.vitals-sheet__person {
  margin-top: 7rpx;
  color: #52627a;
  font-size: 26rpx;
  font-weight: 550;
  line-height: 1.4;
}

.vitals-detail-list {
  margin-top: 18rpx;
  overflow: hidden;
}

.vitals-detail-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid #e7edf4;
  box-sizing: border-box;
}

.vitals-detail-row:last-child {
  border-bottom: 0;
}

.vitals-detail-row__label {
  flex: 0 0 auto;
  color: #637083;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.35;
}

.vitals-detail-row__value {
  min-width: 0;
  color: #172033;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1.35;
  text-align: right;
  word-break: break-word;
}

.vitals-sheet__footnote {
  margin: 18rpx 8rpx 0;
  color: #637083;
  font-size: 24rpx;
  font-weight: 550;
  line-height: 1.5;
  text-align: center;
}
