.library-list-page { padding-top: 20rpx; }
.library-list-loading, .library-list-error { margin-top: 22rpx; }
.library-list-error { padding: 34rpx 28rpx; text-align: center; }
.library-list-error__title { color: #172033; font-size: 34rpx; font-weight: 900; }
.library-list-error__message { margin-top: 10rpx; color: #52627a; font-size: 27rpx; }
.library-list-error__retry { width: 100%; min-height: 88rpx; margin-top: 22rpx; border-radius: 20rpx; background: #147d73; color: #fff; font-size: 28rpx; font-weight: 850; }
.library-list-stale { display: flex; align-items: center; gap: 16rpx; margin-top: 22rpx; padding: 20rpx; background: #fff8e8; border-color: #f4cf75; }
.library-list-stale__copy { min-width: 0; flex: 1; color: #845b16; font-size: 25rpx; font-weight: 650; }
.library-list-stale__retry { flex: 0 0 auto; min-height: 68rpx; padding: 0 18rpx; border-radius: 16rpx; background: #a56716; color: #fff; font-size: 25rpx; font-weight: 800; }
.library-tools { margin-top: 22rpx; padding: 18rpx; }
.library-search { min-height: 88rpx; display: flex; align-items: center; gap: 14rpx; padding: 0 18rpx; border-radius: 18rpx; background: #f4f8fb; }
.library-search__icon { color: #637083; font-size: 30rpx; }
.library-search input { min-width: 0; flex: 1; color: #172033; font-size: 27rpx; font-weight: 650; }
.library-box-scroll { width: 100%; margin-top: 16rpx; white-space: nowrap; }
.library-box-row { display: inline-flex; gap: 10rpx; min-width: 100%; }
.library-box-tab { min-height: 76rpx; display: inline-flex; align-items: center; justify-content: center; padding: 0 24rpx; border-radius: 16rpx; background: #eef3f8; color: #52627a; font-size: 26rpx; font-weight: 800; }
.library-box-tab.is-active { background: #dff5ef; color: #087c68; }
.library-filter-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 12rpx; }
.library-filter { min-height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #59677b; background: #eef2f7; font-size: 25rpx; font-weight: 800; }
.library-filter.is-active { color: #174fd6; background: #e8f0ff; }
.library-filter.is-active.is-warn { color: #8b570f; background: #fff3df; }
.library-list { overflow: hidden; }
.library-row { min-height: 148rpx; gap: 14rpx; padding: 20rpx; }
.library-box-symbol { flex: 0 0 56rpx; width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; color: #174fd6; background: #eaf2ff; font-size: 26rpx; font-weight: 900; }
.library-box-symbol--DAILY { color: #174fd6; background: #eaf2ff; }
.library-box-symbol--CARE { color: #8b570f; background: #fff4e4; }
.library-box-symbol--PRESCRIPTION { color: #7a4db3; background: #f2eaff; }
.library-box-symbol--large { flex-basis: 76rpx; width: 76rpx; height: 76rpx; border-radius: 22rpx; font-size: 32rpx; }
.library-row__meta { margin-top: 6rpx; color: #637083; font-size: 24rpx; font-weight: 650; line-height: 1.35; }
.library-row__right { flex: 0 0 180rpx; text-align: right; }
.library-row__expiry { margin-top: 8rpx; overflow: hidden; color: #637083; font-size: 24rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.library-detail-scroll { max-height: 64vh; padding: 0 28rpx calc(34rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.library-detail-hero { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 0 26rpx; }
.library-detail-hero__copy { min-width: 0; flex: 1; }
.library-detail-name { color: #172033; font-size: 36rpx; font-weight: 900; line-height: 1.3; word-break: break-all; }
.library-detail-spec { margin-top: 6rpx; color: #637083; font-size: 26rpx; font-weight: 650; }
.library-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.library-detail-item { min-width: 0; padding: 20rpx; border-radius: 18rpx; background: #f4f8fb; }
.library-detail-item--wide { grid-column: 1 / -1; }
.library-detail-item--attention { background: #fff7e8; border: 1rpx solid #f3d69b; }
.library-detail-item--attention text { color: #8b570f; }
.library-detail-item--guidance { background: #eaf8f4; border: 1rpx solid #b7e5d9; }
.library-detail-item--guidance text { color: #087c68; }
.library-detail-item text { display: block; color: #637083; font-size: 24rpx; font-weight: 700; }
.library-detail-item view { margin-top: 8rpx; color: #172033; font-size: 27rpx; font-weight: 800; line-height: 1.45; word-break: break-all; }
.library-detail-footnote { margin-top: 18rpx; padding: 18rpx 20rpx; color: #52627a; background: #eef5f8; border-radius: 16rpx; font-size: 24rpx; font-weight: 650; line-height: 1.55; }
@media (max-width: 360px) {
  .library-row__right { flex-basis: 148rpx; }
  .library-row__expiry { display: none; }
}
