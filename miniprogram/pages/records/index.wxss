.care-record-sheet__scroll {
  max-height: 60vh;
  padding: 18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.care-record-sheet__item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e8eef5;
}

.care-record-sheet__item:last-child {
  border-bottom: 0;
}

.care-record-sheet__time {
  flex: 0 0 104rpx;
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #174fd6;
  background: #eaf2ff;
}

.care-record-sheet__time.is-vitals {
  color: #087c68;
  background: #eaf8f3;
}

.care-record-sheet__time.is-safety {
  color: #b42318;
  background: #fff0ee;
}

.care-record-sheet__time text {
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.care-record-sheet__time label {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1;
}

.care-record-sheet__copy {
  flex: 1;
  min-width: 0;
}

.care-record-sheet__title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.care-record-sheet__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.care-record-sheet__meta text {
  max-width: 100%;
  padding: 8rpx 11rpx;
  border-radius: 10rpx;
  color: #59677b;
  background: #f0f4f8;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  box-sizing: border-box;
}

.care-record-sheet__meta--vitals text {
  color: #087c68;
  background: #eaf8f3;
}

.care-record-sheet__meta--safety text {
  color: #8f281f;
  background: #fff1ef;
}

.care-record-sheet__more {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 4rpx 4rpx;
  border-top: 1rpx solid #e8eef5;
  box-sizing: border-box;
}

.care-record-sheet__more-label {
  flex: 0 0 auto;
  color: #2463eb;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.care-record-sheet__more-hint {
  flex: 1;
  min-width: 0;
  color: #7b8798;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.35;
  text-align: right;
}

.care-record-sheet__more.is-loading .care-record-sheet__more-label,
.care-record-sheet__more.is-loading .care-record-sheet__more-hint {
  color: #8793a3;
}

.care-record-sheet__more.is-error .care-record-sheet__more-label {
  color: #b42318;
}
