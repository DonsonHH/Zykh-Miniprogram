.medication-risks-page { padding-top: 20rpx; }
.risk-detail-scroll { max-height: 66vh; padding: 0 28rpx calc(34rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.risk-detail-hero { margin-top: 10rpx; padding: 26rpx; border-radius: 22rpx; background: #eef6ff; }
.risk-detail-hero.is-high { background: #fff1f0; }
.risk-detail-hero.is-review { background: #fff7e8; }
.risk-detail-kicker { color: #52627a; font-size: 24rpx; font-weight: 850; }
.risk-detail-title { margin-top: 8rpx; color: #172033; font-size: 36rpx; font-weight: 900; line-height: 1.3; word-break: break-all; }
.risk-detail-summary { margin-top: 12rpx; color: #384860; font-size: 27rpx; font-weight: 650; line-height: 1.55; word-break: break-all; }
.risk-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 16rpx; }
.risk-detail-item { min-width: 0; padding: 20rpx; border-radius: 18rpx; background: #f4f8fb; }
.risk-detail-item--wide { grid-column: 1 / -1; }
.risk-detail-item text { display: block; color: #637083; font-size: 24rpx; font-weight: 700; }
.risk-detail-item view { margin-top: 8rpx; color: #172033; font-size: 27rpx; font-weight: 800; line-height: 1.5; word-break: break-all; }
