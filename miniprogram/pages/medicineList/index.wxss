.medicine-list-page {
  padding-top: 20rpx;
}

.medicine-list-loading {
  margin-top: 22rpx;
}

.medicine-list-error {
  margin-top: 22rpx;
  padding: 34rpx 28rpx;
  text-align: center;
}

.medicine-list-error__title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.medicine-list-error__message {
  margin-top: 12rpx;
  color: #52627a;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
}

.medicine-list-error__retry {
  width: 100%;
  min-height: 88rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 850;
}

.medicine-list-stale {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-color: #f4cf75;
  background: #fff8e8;
}

.medicine-list-stale__copy {
  flex: 1;
  color: #845b16;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.45;
}

.medicine-list-stale__retry {
  flex: 0 0 auto;
  min-height: 68rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #b7791f;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
}

.medicine-list-stale__retry::after {
  border: 0;
}

.cabinet-list-summary {
  min-height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  border-color: #cfe0f2;
  background: linear-gradient(145deg, #ffffff 0%, #f2f7ff 100%);
  box-sizing: border-box;
}

.cabinet-list-summary__title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.cabinet-primary {
  flex: 0 0 auto;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.2;
  box-shadow: 0 10rpx 22rpx rgba(37, 99, 235, 0.16);
}

.cabinet-primary::after {
  border: 0;
}

.cabinet-tools {
  margin-top: 22rpx;
  padding: 18rpx;
}

.cabinet-search {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dbe7f3;
  border-radius: 18rpx;
  background: #f7f9fc;
  box-sizing: border-box;
}

.cabinet-search__icon {
  flex: 0 0 auto;
  color: #637083;
  font-size: 30rpx;
  line-height: 1;
}

.cabinet-search input {
  min-width: 0;
  flex: 1;
  color: #172033;
  font-size: 27rpx;
  font-weight: 650;
}

.cabinet-filter-scroll {
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}

.cabinet-filter-row {
  display: inline-flex;
  gap: 10rpx;
  padding: 2rpx;
}

.cabinet-filter {
  min-height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #eef2f7;
  color: #52627a;
  font-size: 26rpx;
  font-weight: 750;
  box-sizing: border-box;
}

.cabinet-filter.is-active {
  background: #e8f0ff;
  color: #174fd6;
}

.cabinet-filter.is-active.is-warn {
  background: #fff2df;
  color: #94510a;
}

.cabinet-filter.is-active.is-danger {
  background: #fff0ee;
  color: #b42318;
}

.cabinet-filter.is-active.is-notice {
  background: #e8f0ff;
  color: #174fd6;
}

.medicine-list-section {
  margin-top: 22rpx;
}

.cabinet-list {
  overflow: hidden;
}

.cabinet-row {
  min-height: 132rpx;
  gap: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.cabinet-slot {
  flex: 0 0 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: #eaf2ff;
  color: #174fd6;
  font-size: 27rpx;
  font-weight: 900;
}

.cabinet-row__headline {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cabinet-expiry {
  flex: 0 0 auto;
  max-width: 184rpx;
  text-align: right;
}

.cabinet-expiry__date {
  margin-top: 7rpx;
  overflow: hidden;
  color: #637083;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.medicine-list-page .ui-row-title {
  display: -webkit-box;
  white-space: normal;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

@media (max-width: 360px) {
  .cabinet-list-summary {
    align-items: flex-start;
    flex-direction: column;
  }

  .cabinet-primary {
    width: 100%;
  }

  .cabinet-expiry__date {
    display: none;
  }
}
